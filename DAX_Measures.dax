/* ==============================================================================
   RELIANCE RETAIL LIMITED - DAX MEASURES LIBRARY (POWER BI)
   Star Schema: Fact_Reliance_Sales, Dim_Store_Format, Dim_Geography, Dim_Fiscal_Calendar
   ============================================================================== */

-- 1. TOTAL GROSS INVOICED REVENUE (INR)
[Gross Revenue INR] = 
SUM ( 'Fact_Reliance_Sales'[Gross_Invoiced_Sales] )

-- 2. NET REALIZED OPERATING PROFIT
[Net Realized Profit] = 
SUM ( 'Fact_Reliance_Sales'[Net_Profit_Amount] )

-- 3. REALIZED PROFIT MARGIN %
[Profit Margin %] = 
DIVIDE ( 
    [Net Realized Profit], 
    [Gross Revenue INR], 
    0 
)

-- 4. TOTAL UNIQUE INVOICED TRANSACTIONS
[Total Invoiced Orders] = 
DISTINCTCOUNT ( 'Fact_Reliance_Sales'[Invoice_ID] )

-- 5. AVERAGE BASKET VALUE / AOV
[Average Order Value] = 
DIVIDE ( 
    [Gross Revenue INR], 
    [Total Invoiced Orders], 
    0 
)

-- 6. TOTAL UNITS DISPATCHED
[Total Units Dispatched] = 
SUM ( 'Fact_Reliance_Sales'[Quantity] )

-- 7. SAME-PERIOD-LAST-YEAR SALES (TIME INTELLIGENCE)
[Sales SPLY] = 
CALCULATE ( 
    [Gross Revenue INR], 
    SAMEPERIODLASTYEAR ( 'Dim_Fiscal_Calendar'[Date] ) 
)

-- 8. YEAR-OVER-YEAR REVENUE EXPANSION RATE %
[YoY Sales Growth %] = 
VAR CurrentSales = [Gross Revenue INR]
VAR PriorYearSales = [Sales SPLY]
RETURN
    DIVIDE ( CurrentSales - PriorYearSales, PriorYearSales, 0 )

-- 9. TOTAL OUTPUT GST TAX COLLECTED
[GST Output Collected] = 
SUM ( 'Fact_Reliance_Sales'[GST_Amount] )

-- 10. JIOMART OMNI-CHANNEL REVENUE SHARE
[JioMart Omni Share %] = 
DIVIDE (
    CALCULATE ( [Gross Revenue INR], 'Dim_Store_Format'[Format_Name] = "JioMart Omni" ),
    [Gross Revenue INR],
    0
)
